# ============================================================
# URL Security Checker - Environment Variables Example
# ============================================================
# Salin file ini menjadi .env.local dan isi dengan API key Anda
# JANGAN pernah commit file .env.local ke Git!

# --- Google Safe Browsing API v4 ---
# Cara mendapatkan:
# 1. Buka https://console.cloud.google.com/
# 2. Buat project baru atau pilih project yang ada
# 3. Aktifkan "Safe Browsing API" di Library
# 4. Buat Credentials -> API Key
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# --- VirusTotal API v3 ---
# Cara mendapatkan:
# 1. Daftar akun gratis di https://www.virustotal.com/
# 2. Masuk ke akun Anda
# 3. Klik ikon profil -> API Key
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
